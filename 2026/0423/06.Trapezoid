#include <stdio.h>

int main() {
    // 1. 변수 선언 (윗변, 아랫변, 높이, 넓이)
    double a, b, h, area;

    // 2. 값 입력받기
    printf("사다리꼴의 윗변 아랫변 높이를 입력하세요: ");
    scanf("%lf %lf %lf", &a, &b, &h);

    // 3. 넓이 계산 (괄호 사용이 핵심!)
    // (a + b)에 괄호를 치지 않으면 곱셈이 먼저 계산됨
    area = (a + b) * h / 2.0;

    // 4. 결과 출력
    printf("사다리꼴의 넓이는 %.2f입니다.\n", area);
    
    return 0;
}
